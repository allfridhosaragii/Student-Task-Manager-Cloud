# ==============================================================================
# STUDENT TASK MANAGER - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Salin file ini menjadi .env pada host / VM: cp .env.example .env
# PENTING: File .env asli TIDAK BOLEH di-push ke repository GitHub!
# ==============================================================================

# Lingkungan runtime aplikasi (production / development)
NODE_ENV=production

# Port HTTP pada host VM yang akan dipetakan ke kontainer aplikasi (default 80)
HOST_HTTP_PORT=80

# Port internal aplikasi di dalam kontainer
APP_PORT=3000

# URL publik aplikasi (ganti dengan IP Publik Azure VM Anda saat deploy)
APP_URL=http://<IP_PUBLIC_VM>

# Konfigurasi Database Internal PostgreSQL
DB_HOST=database
DB_PORT=5432
DB_NAME=student_tasks
DB_USER=taskuser
DB_PASSWORD=GantiDenganPasswordRahasiaAman2026!
